# ---- Sectors API (pemilik: B) ----
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app
# live | cache_only | replay  (bab 6.1)
SECTORS_MODE=cache_only
# Berkas rekaman untuk mode replay
SECTORS_RECORDING=./recordings/demo.jsonl
# Anggaran kredit per satu cek (bab 3.4: maks 8 kredit per klaim)
SECTORS_BUDGET_PER_CHECK=40
# Pos anggaran anggota yang sedang dipakai: A | B | C | D | demo | cadangan
SECTORS_MEMBER=B

# ---- Supabase (pemilik: B) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM (pemilik: A) ----
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
# Demo fixture hanya untuk pengujian lokal; mati di produksi
CHECK_FIXTURE_DEMO=0

# ---- Dasbor admin ----
ADMIN_TOKEN=
